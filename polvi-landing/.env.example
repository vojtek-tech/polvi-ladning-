# Supabase config for the landing page's cross-domain session detection.
# Must be the SAME project as app.polvi.ai, or the tokens in the shared cookie
# will not validate.
#
# The real .env IS committed to this repo, deliberately: this is a frontend-only
# build, so every value here is inlined into the bundle and served to the browser.
# There is no such thing as a private env var in it. The VITE_ prefix is the marker
# for that — Vite exposes only VITE_-prefixed variables to client code. This file
# stays as documentation of what the build requires.
#
# Row Level Security on the Supabase side is the security boundary, not the key.
#
# Never put a service-role key here. vite.config.ts decodes the key and fails the
# build if it is privileged, but the rule is simply: privileged work belongs in a
# serverless function, not in this bundle.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
