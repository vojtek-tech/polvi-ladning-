# Supabase config for the landing page. Committed on purpose.
#
# This is a frontend-only build: both values below are inlined into the bundle and
# served to every visitor, so neither is a secret. The VITE_ prefix marks that —
# Vite exposes only VITE_-prefixed variables to client code. Committing them keeps
# local, CI and Vercel builds working with no per-environment setup.
#
# Row Level Security on the Supabase side is the security boundary, not these values.
# A service-role key must never appear here; vite.config.ts fails the build if one does.
VITE_SUPABASE_URL=https://cbqhaitdlvakagordlfl.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNicWhhaXRkbHZha2Fnb3JkbGZsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjU5MDA2NzYsImV4cCI6MjA4MTQ3NjY3Nn0.Z409oRBNs-pnkI1gbh8UeAxsRWuyxwJtFrOlGJSsesw
